# LANShare · Nginx 反代示例（证书完全由 Nginx 提供，后端跑纯 HTTP）
# 复制为实际站点配置，把 share.example.com 与证书路径换成自己的。
# 后端固定是 127.0.0.1:8080：Docker 见 .env 的 HTTP_PORT；裸机见 README 第 5 节
# 的 ./lanshare -no-tls -addr 127.0.0.1:8080 -trust-proxy。
#
# 群晖 DSM 7 裸机部署要点（完整流程见 README 第 5 节）：
#   - 本文件放 /etc/nginx/sites-enabled/lanshare.conf。该目录 include 任意 *.conf，
#     重启 / DSM 升级不会被模板覆盖；不要手改 /etc/nginx/nginx.conf 或 UI 生成的
#     server.ReverseProxy.conf。
#   - 下面的 map 通常 DSM 已全局定义。先执行：
#       sudo nginx -T -c /etc/nginx/nginx.conf.run 2>/dev/null | grep -n 'map \$http_upgrade'
#     有输出 → 删掉本文件的 map，只保留 proxy_set_header Connection $connection_upgrade；
#     无输出 → 把 map 单独放 /etc/nginx/conf.d/http.lanshare.conf（文件名必须 http.*.conf）。
#     重复定义会让 nginx -t 报 duplicate "connection_upgrade" variable。
#   - ssl_certificate / ssl_certificate_key 用群晖证书实际路径：
#       sudo ls /usr/syno/etc/certificate/_archive/   → <ID>/fullchain.pem、<ID>/privkey.pem
#   - 校验并生效（DSM 7 实际运行 nginx.conf.run，务必先 -t 再 reload）：
#       sudo nginx -t -c /etc/nginx/nginx.conf.run
#       sudo nginx -s reload -c /etc/nginx/nginx.conf.run

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name share.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    # 需要 HTTP/2 时：Nginx >= 1.25.1 加 "http2 on;"；旧版改为 "listen 443 ssl http2;"
    server_name share.example.com;

    ssl_certificate     /etc/letsencrypt/live/share.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/share.example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # 业务数据只走 WebRTC / TURN，服务端不接收文件上传；限制请求体防滥用。
    client_max_body_size 1m;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;

        # 关键：Host 必须与浏览器 Origin 的域名一致，否则 WS upgrade 的 Origin 校验会拒绝。
        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Proto $scheme;

        # 关键：用 $remote_addr 覆盖（而非 $proxy_add_x_forwarded_for 追加），
        # 防止客户端伪造 XFF 骗取「同局域网」分组。trust-proxy 依赖这个值。
        proxy_set_header X-Forwarded-For  $remote_addr;

        # WebSocket（/ws）必须
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location = /health {
        proxy_pass http://127.0.0.1:8080/health;
        access_log off;
    }
}
