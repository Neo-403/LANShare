# 复制为 .env 后修改；.env 已被 .gitignore 忽略，切勿提交真实密钥。
#   PowerShell: Copy-Item .env.example .env
#   Linux:      cp .env.example .env
# 只需要 docker-compose.yml + .env 即可部署，无需拉取项目里的其它文件。

# 浏览器访问的对外域名；只有启用可选 coturn 时才需要（同时用作 TURN realm），
# 不要带协议和端口。默认无 coturn 部署可留空。
PUBLIC_HOST=share.example.com

# Nginx 反代的目标端口。注意：compose 目前把端口硬编码为 "8080:8080"，
# 本变量只用于说明 Nginx 应转发到哪个端口，修改它不会改变 compose 映射。
# 生产环境请配合防火墙或把映射改为 127.0.0.1:8080:8080，不要直接对外暴露 HTTP。
HTTP_PORT=8080

# ---- 服务器 WS 中继带宽（默认不限速）----
# 0 = 不限速，尽可能跑满服务器与客户端之间的实际带宽。
# 只在需要给「单个连接」设上限时填 MB/s，例如 RELAY_RATE_MB=20
RELAY_RATE_MB=0

# ---- 外部 ICE 服务器：决定是否需要打洞 ----
# STUN_URLS 与 TURN_URLS 都留空（下面默认值）：服务端不下发任何 STUN/TURN，
# 内网仍走 host candidate 直连，跨网因为无法打洞会直接走 LANShare 服务器的
# WS 完整中继（聊天 + 文件，只走 443，不需要开放 UDP 端口）。
# 适用于没有可用外网 STUN/TURN 的环境，也是本项目的默认兜底模式。
#
# 需要跨网打洞时填一个 STUN，例如（以下两行只是示例，不是默认值）：
#   STUN_URLS=stun:stun.l.google.com:19302
# 自建 coturn 时可用它的 STUN：
#   STUN_URLS=stun:share.example.com:3478
STUN_URLS=

# 填了它（并且配了 TURN_SECRET）才会向浏览器下发 TURN。
# 例： turn:share.example.com:3478?transport=udp,turn:share.example.com:3478?transport=tcp
TURN_URLS=

# ---- 以下仅「启用可选 coturn」时才需要 ----
# 生成密钥： openssl rand -hex 24
TURN_SECRET=

# 服务器在 NAT 之后（如家用宽带、部分云主机）才需要：公网IP/内网IP
# 直接持有公网 IP 的云主机留空即可
TURN_EXTERNAL_IP=

# 启用标准 TURN：填好 STUN_URLS / TURN_URLS / TURN_SECRET（NAT 后加 TURN_EXTERNAL_IP），
# 然后执行 docker compose --profile turn up -d，并放行 3478 与 40000-40200 的 UDP。
