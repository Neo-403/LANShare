# 复制为 .env 后修改；.env 已被 .gitignore 忽略，切勿提交真实密钥。
#   PowerShell: Copy-Item .env.example .env
#   Linux:      cp .env.example .env

# 浏览器访问的对外域名（同时用作 TURN realm），不要带协议和端口
PUBLIC_HOST=share.example.com

# lanshare 与 coturn 共享的 TURN 密钥，必须随机生成并保密。
# 生成示例： openssl rand -hex 24
TURN_SECRET=CHANGE_ME_RANDOM_SECRET

# 服务器在 NAT 之后（如家用宽带、部分云主机）才需要：公网IP/内网IP
# 直接持有公网 IP 的云主机留空即可
TURN_EXTERNAL_IP=

# 宿主机 Nginx 反代到 127.0.0.1:HTTP_PORT；不对外暴露 HTTP
HTTP_PORT=8080
